rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── LEADS ──────────────────────────────────────────────────────────────
    // CRM (comptes connectés) : tout, comme avant (sauf le compte site@ qui ne peut que créer).
    // Site solocimmo.fr (non connecté) : CRÉATION SEULE, au format du popup WhatsApp.
    match /leads/{leadId} {
      allow read, update, delete: if request.auth != null && request.auth.token.email != "site@solocimmo.fr";
      allow create: if request.auth != null;
      allow create: if request.auth == null
        && request.resource.data.keys().hasOnly(['firstName','lastName','name','phone','email','column','relanceCount','paid',
             'notes','criteria','createdAt','lastActivity','source','whatsappContact','history','origine'])
        && request.resource.data.column == 'premier_contact'
        && request.resource.data.source == 'whatsapp'
        && request.resource.data.paid == false
        && request.resource.data.relanceCount == 0
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 6 && request.resource.data.phone.size() <= 40
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000))
        && (!('origine' in request.resource.data) || (
             request.resource.data.origine.keys().hasOnly(['bouton','provenance','campagne'])
             && request.resource.data.origine.bouton is string && request.resource.data.origine.bouton.size() <= 40
             && request.resource.data.origine.provenance is string && request.resource.data.origine.provenance.size() <= 40
             && (!('campagne' in request.resource.data.origine) || (request.resource.data.origine.campagne is string && request.resource.data.origine.campagne.size() <= 80))
           ));
    }

    // ── CLICS (compteur anonyme du site, statistiques de Charles) ─────────
    // Id : <date>_<bouton>_<provenance>. Le site peut créer à 1 ou ajouter 1, rien d'autre. Lecture : Charles.
    match /clics/{clicId} {
      allow read: if request.auth != null && request.auth.token.email == "charlesblyopro@gmail.com";
      allow create: if request.resource.data.keys().hasOnly(['date','bouton','provenance','n'])
        && request.resource.data.n == 1
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.bouton is string && request.resource.data.bouton.size() <= 40
        && request.resource.data.provenance is string && request.resource.data.provenance.size() <= 40
        && clicId == request.resource.data.date + '_' + request.resource.data.bouton + '_' + request.resource.data.provenance;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
    }

    // ── RESTE DU CRM (inchangé) ───────────────────────────────────────────
    match /partenaires/{partenaireId} {
      allow read, write: if request.auth != null;
    }
    match /biens/{bienId} {
      allow read, write: if request.auth != null;
    }
    match /todos/{todoId} {
      allow read, write: if request.auth != null;
    }
    match /todosV2/{doc} {
      allow read, write: if request.auth != null;
    }
    match /dossiers/{dossierId} {
      allow read, write: if request.auth != null;
    }
    match /finance/{doc} {
      allow read, write: if request.auth != null && request.auth.token.email == "charlesblyopro@gmail.com";
    }
    match /newsletter/{doc} {
      allow read, write: if request.auth != null;
    }
    match /soumissions/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    match /lettres/{id} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null || (
        resource.data.status == "a_signer" &&
        request.resource.data.status == "signe" &&
        request.resource.data.montant == resource.data.montant &&
        request.resource.data.titre == resource.data.titre
      );
    }
    match /captures/{id} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
